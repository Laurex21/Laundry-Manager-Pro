# Preparation template ONLY. Not loaded automatically by Replit or the app.
# Install in deployment Secrets only during the separately authorised release.
NODE_ENV=production
SAAS_BILLING_MODE=disabled
SAAS_LIVE_ENABLED=false
SAAS_DATABASE_ENVIRONMENT=production
SAAS_PRODUCTION_ORIGIN=https://app.xpressclean.cm

# Supply the live token through server Secrets; never commit its value.
PAWAPAY_PRODUCTION_API_TOKEN=

# Do not paste DATABASE_URL here. Verify the destination of the existing Secret
# and take/restore-check an authorised backup before applying reviewed migrations.
# Activation later requires BOTH SAAS_BILLING_MODE=live and SAAS_LIVE_ENABLED=true.

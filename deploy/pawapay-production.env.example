# Preparation template ONLY. Not loaded automatically by Replit or the app.
# Install in deployment Secrets only during the separately authorised release.
NODE_ENV=production
SAAS_BILLING_MODE=disabled
SAAS_LIVE_ENABLED=false
# Opt-in v6 Business trial transition; keep false during preparation.
SAAS_BUSINESS_LAUNCH_ENABLED=false
SAAS_DATABASE_ENVIRONMENT=production
SAAS_PRODUCTION_ORIGIN=https://app.xpressclean.cm

# Supply the live token through server Secrets; never commit its value.
PAWAPAY_PRODUCTION_API_TOKEN=

# Do not paste DATABASE_URL here. Verify the destination of the existing Secret
# and take/restore-check an authorised backup before applying reviewed migrations.
# Activation later requires BOTH SAAS_BILLING_MODE=live and SAAS_LIVE_ENABLED=true.

# Temporary: pause automatic data maintenance during release verification.
# Remove or set false after the separately approved verification window.
XPRESSPRO_AUTOMATIC_MAINTENANCE_SUSPENDED=true

# Optional, separate 50 XAF collection-only pilot (does NOT buy/activate a plan).
# Preparation only: keep billing disabled and live false until separate approval.
# SAAS_LIVE_PILOT_PURPOSE=collection
# SAAS_LIVE_PILOT_ORGANISATION_ID=<verified organisation id>
# Scope and amount are server controlled; collection callbacks never alter subscriptions.
